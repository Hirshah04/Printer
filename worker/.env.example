# Worker Identification
WORKER_ID=cloud-worker-prod-1
WORKER_NAME=Production Cloud Print Worker

# Backend Connection
BACKEND_URL=http://localhost:5000
WORKER_API_KEY=worker-secret-token-change-this-to-a-high-entropy-random-string

# WireGuard VPN Configuration
WIREGUARD_INTERFACE=wg0
GATEWAY_IP=10.14.0.1
DEFAULT_PRINTER_IP=192.168.1.150

# Worker Tuning
POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=15000
PRINTER_MONITOR_INTERVAL_MS=30000

# Format Conversion Mode (auto | ghostscript | pclm | raw)
CONVERTER_MODE=auto

# Optional Redis Queue
# REDIS_URL=redis://127.0.0.1:6379
