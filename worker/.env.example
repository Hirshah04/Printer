# Worker Configuration
WORKER_ID=home-print-worker
WORKER_NAME=Home Local Print Worker

# Backend Connection (Render Cloud Backend)
BACKEND_URL=https://printer-8bki.onrender.com
WORKER_API_KEY=printer-worker-auth-secret-token-xyz

# Printer Configuration
DEFAULT_PRINTER_IP=192.168.1.37
# WINDOWS_PRINTER_NAME: Set to 'auto' to automatically detect USB or Wi-Fi printer
WINDOWS_PRINTER_NAME=auto

# Polling and Monitoring Intervals (ms)
POLL_INTERVAL_MS=2000
HEARTBEAT_INTERVAL_MS=15000
PRINTER_MONITOR_INTERVAL_MS=20000
