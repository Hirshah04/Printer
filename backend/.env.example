# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Target HP LaserJet Pro MFP M126nw LAN Address
PRINTER_IP=103.209.67.76
PRINTER_PORT=631
PRINTER_ENDPOINT=/ipp/printer

# Cloud Print Worker Authentication Secret
WORKER_API_KEY=worker-secret-token-change-this-to-a-high-entropy-random-string

# PDF File Storage (local | s3 | r2)
STORAGE_TYPE=local
MAX_FILE_SIZE_MB=25

# Optional Cloudflare R2 / AWS S3 Credentials (if not using local storage)
# STORAGE_TYPE=r2
# AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key
# AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_BUCKET=remote-printer-storage
# AWS_REGION=auto
