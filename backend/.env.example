# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/remote_printer_hub?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# Cloud Print Worker Authentication Key
WORKER_API_KEY=worker-secret-token-change-this-to-a-high-entropy-random-string

# Cloud Storage Configuration (local | s3 | r2)
STORAGE_TYPE=local
MAX_FILE_SIZE_MB=25

# Optional AWS S3 / Cloudflare R2 Credentials
# STORAGE_TYPE=r2
# AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key
# AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_BUCKET=remote-printer-storage
# AWS_REGION=auto

# Optional Redis Connection (BullMQ Queue)
# REDIS_URL=redis://127.0.0.1:6379
